# Services "Book a free preview" form → email delivery (Resend).
# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Required. Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Verified sender for the preview-request emails.
# Leave unset to use Resend's sandbox sender (onboarding@resend.dev), which can
# ONLY deliver to the Resend account owner's own address — fine for testing.
# For production, verify alexbritoofficial.com in Resend and set e.g.:
#   PREVIEW_FROM_EMAIL="Alex Brito <hello@alexbritoofficial.com>"
PREVIEW_FROM_EMAIL=
